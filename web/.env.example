API_BASE=https://api.example.com          # public API origin (browser)
API_BASE_INTERNAL=http://api.railway.internal:8080   # server-side (private network)
SITE_URL=https://new.flystat.com
SITE_MODE=demo                            # demo | published
BASIC_AUTH=flystat:demo-password          # optional while in demo
REVALIDATE_SECRET=change-me               # same as API REVALIDATE_SECRET
MEDIA_BASE=https://api.example.com        # where /storage uploads are served from
